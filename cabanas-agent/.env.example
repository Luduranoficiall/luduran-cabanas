# Gemini (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
# ATENCAO: nao e o telefone. E o ID numerico que a Meta da ao numero dentro da
# WhatsApp Business Account. Pegar em App -> WhatsApp -> API Setup, campo
# "Phone number ID". Sao ~15 digitos e nao tem relacao com o DDD.
WHATSAPP_PHONE_NUMBER_ID=
# Numero oficial de atendimento (secretaria do clube), so para conferencia
# humana e para aparecer no /health. Nao e usado em chamada de API.
WHATSAPP_PHONE_NUMBER=+55 54 98448-7198
WHATSAPP_VERIFY_TOKEN=
# Segredo do app na Meta, usado para validar a assinatura do webhook.
# Obrigatorio em producao.
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v21.0

# GCP
GCP_PROJECT_ID=serious-trainer-465716-j9
FIRESTORE_COLLECTION=cabanas_leads

# Numero que recebe o aviso de escalacao. So digitos, com DDI, sem + nem
# pontuacao. +55 54 98448-7198 -> 5554984487198
ESCALATION_NUMBER=5554984487198

# Cabanas no ar. A cabana 3 existe, mas o anuncio dela ainda nao foi criado no
# Airbnb. Quando o link chegar, trocar as duas linhas abaixo e reiniciar:
#
#   CABANAS=1,2,3,4,5
#   CABANA_URLS=3=https://airbnb.com.br/h/o-link-que-vier
#
# Nao e preciso alterar codigo: prompt e links sao montados a partir daqui.
CABANAS=1,2,4,5
# Links avulsos ou correcoes, formato "numero=url" separados por virgula.
CABANA_URLS=

# Quantas mensagens anteriores entram no contexto do modelo
HISTORY_LIMIT=6
