# Gemini (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Segredo do app na Meta, usado para validar a assinatura do webhook.
# Obrigatorio em producao.
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v21.0

# GCP
GCP_PROJECT_ID=serious-trainer-465716-j9
FIRESTORE_COLLECTION=cabanas_leads

# Numero que recebe o aviso de escalacao (so digitos, com DDI). Ex.: 5548999998888
ESCALATION_NUMBER=

# Cabanas ativas. Enquanto a cabana 3 nao for confirmada com a Camile,
# suba com: CABANAS=1,2,4,5
CABANAS=1,2,3,4,5

# Quantas mensagens anteriores entram no contexto do modelo
HISTORY_LIMIT=6
