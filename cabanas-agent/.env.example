# Gemini (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Teto por chamada, em segundos. Sem isso, chamada travada nunca devolve
# nem o fallback.
GEMINI_TIMEOUT_S=12

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
# ATENCAO: nao e o telefone. E o ID numerico que a Meta da ao numero dentro da
# WhatsApp Business Account. Pegar em App -> WhatsApp -> API Setup, campo
# "Phone number ID". Sao ~15 digitos e nao tem relacao com o DDD.
WHATSAPP_PHONE_NUMBER_ID=
# Numero do SISTEMA — chip novo (Vivo), exclusivo da Cloud API. So para
# conferencia humana e para aparecer no /health; nao e usado em chamada de API.
# NAO e o numero da secretaria (esse e o ESCALATION_NUMBER, la embaixo).
WHATSAPP_PHONE_NUMBER=+55 54 99910-3545
WHATSAPP_VERIFY_TOKEN=
# Segredo do app na Meta, usado para validar a assinatura do webhook.
# Obrigatorio em producao.
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v21.0

# GCP
GCP_PROJECT_ID=serious-trainer-465716-j9
FIRESTORE_COLLECTION=cabanas_leads
# Qual operacao gerou o registro. Ja entra agora para que os proximos
# nichos (academia, alojamento, sushi...) nao exijam migracao de dado.
NICHO=cabanas
# Nichos que o painel oferece no filtro. Cresce conforme as operacoes entram.
NICHOS_PAINEL=cabanas
# Cookie de sessao do painel so sai por HTTPS. Use 0 apenas em teste local.
COOKIE_SEGURO=1
# Percentual da Luduran sobre as reservas confirmadas (combinado: 10%).
COMISSAO_PERCENTUAL=10

# Numero que recebe o aviso de escalacao: a secretaria do clube, que segue no
# WhatsApp normal. So digitos, com DDI, sem + nem pontuacao.
# +55 54 98448-7198 -> 5554984487198
ESCALATION_NUMBER=5554984487198

# Template aprovado na Meta para o aviso de escalacao.
#
# A Cloud API so entrega texto livre dentro de 24h da ultima mensagem que o
# destinatario mandou para o sistema. A secretaria nunca escreve para o numero
# do sistema, entao a janela dela esta sempre fechada e o texto livre e
# recusado (erro 131047). Template entrega fora da janela.
#
# Vazio = tenta texto livre. O sistema funciona, mas o aviso nao chega — a
# escalacao fica em /painel/escalacoes. Ver passo 6 do DEPLOY.md.
ESCALATION_TEMPLATE=
ESCALATION_TEMPLATE_IDIOMA=pt_BR

# Cabanas no ar. As cinco estao ativas; os links estao em config.py
# (LINKS_CONFIRMADOS). Para tirar uma de operacao, basta remover daqui.
CABANAS=1,2,3,4,5
# Link de cabana nova, ou correcao emergencial sem deploy. Formato
# "numero=url" separado por virgula. Tem precedencia sobre LINKS_CONFIRMADOS.
CABANA_URLS=

# Contexto do modelo: as N ultimas trocas, mas so as dos ultimos M minutos —
# o que vier primeiro. Conversa de ontem nao e contexto, e ruido.
HISTORY_LIMIT=10
HISTORY_JANELA_MIN=30

# Anti-loop: acima de N mensagens em M minutos, o agente para de responder e
# escala. Zero desliga a trava.
ANTILOOP_MENSAGENS=15
ANTILOOP_JANELA_MIN=10
